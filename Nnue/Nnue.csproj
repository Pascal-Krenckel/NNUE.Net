<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0: AVX-VNNI is a preview API there (used behind a runtime check, warning suppressed locally); net10.0: stable, newer JIT;
         net11.0 (added when the .NET 11 SDK builds the project): AVX512-VNNI (AvxVnni.V512) for the int8 dense layers -->
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <RootNamespace>Nnue</RootNamespace>
    <AssemblyName>Nnue</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package (published by .github/workflows/publish.yml; the version comes from the git tag). -->
  <PropertyGroup>
    <PackageId>NNUE.Net</PackageId>
    <!-- TODO before the first release: <Authors>your name</Authors>, and optionally <PackageLicenseExpression>MIT</PackageLicenseExpression> (or another SPDX id)
         and <PackageProjectUrl>. The repository URL is filled in by source link from the git remote. -->
    <Version>0.1.0</Version>
    <Description>Feature-agnostic NNUE (efficiently updatable neural network) library: SIMD evaluation (AVX512-VNNI, AVX-512, AVX-VNNI, AVX2, SSSE3, NEON), incremental accumulator updates, Int16 and Stockfish-style Int8 networks, training, quantization, bullet import.</Description>
    <PackageTags>nnue;neural-network;simd;avx512;inference;training;quantization;chess</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>Nnue.Net</Title>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nnue.Tests" />
    <InternalsVisibleTo Include="Nnue.Benchmarks" />
  </ItemGroup>

</Project>
